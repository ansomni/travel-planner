rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trip-files/{tripCode}/{allPaths=**} {
      // Shared family mode: images are public to anyone with their URL/path.
      allow read: if tripCode.matches('^[A-Z0-9]{6}$');
      allow write: if request.auth != null
        && request.auth.token.tripCode == tripCode
        && request.auth.token.tripEditor == true
        && (request.resource == null || (
          request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        ));
    }
  }
}
